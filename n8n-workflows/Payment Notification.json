      "position": [
        -208,
        112
      ]
    },
    {
      "parameters": {
        "functionCode": "const data = $input.first().json.body;\nconst orderNumber = data.orderNumber || 'Unknown';\nconst amount = data.amount || 0;\nconst customerEmail = data.customerEmail || 'N/A';\n\nconst formattedAmount = new Intl.NumberFormat('id-ID', {\n  style: 'currency',\n  currency: 'IDR',\n  minimumFractionDigits: 0\n}).format(amount);\n\nconst notification = {\n  subject: `Payment Confirmed - Order ${orderNumber}`,\n  body: `Hello!\n\nYour payment has been confirmed.\n\nOrder Number: ${orderNumber}\nAmount: ${formattedAmount}\nCustomer Email: ${customerEmail}\n\nThank you for your purchase!\n\nBest regards,`,\n  customerEmail: customerEmail,\n  orderNumber: orderNumber,\n  amount: formattedAmount\n};\n\nreturn [{ json: notification }];"
      },
      "id": "f003fc18-b7cf-4d8f-8634-7a42421dc67c",
      "name": "Format Notification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "functionCode": "const data = $input.first().json;\nconsole.log('=== PAYMENT NOTIFICATION ===');\nconsole.log('Order:', data.orderNumber);\nconsole.log('Amount:', data.amount);\nconsole.log('Customer:', data.customerEmail);\nconsole.log('Subject:', data.subject);\nconsole.log('============================');\n\nreturn [{ json: { ...data, sentAt: new Date().toISOString(), status: 'logged' } }];"
      },
      "id": "3738e5d6-78df-4fc0-8fc5-eedcf7772ca5",
      "name": "Log Notification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
