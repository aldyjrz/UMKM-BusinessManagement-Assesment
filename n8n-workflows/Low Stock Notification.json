      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -208,
        112
      ]
    },
    {
      "parameters": {
        "functionCode": "const data = $input.first().json.body;\nconst productName = data.productName || 'Unknown Product';\nconst currentStock = data.currentStock || 0;\nconst minimumStock = data.minimumStock || 0;\n\nconst severity = currentStock === 0 ? 'CRITICAL' : 'WARNING';\n\nconst notification = {\n  subject: `[${severity}] Low Stock Alert - ${productName}`,\n  body: `LOW STOCK ALERT\n\nProduct: ${productName}\nCurrent Stock: ${currentStock}\nMinimum Stock: ${minimumStock}\nSeverity: ${severity}\n\nPlease restock this product as soon as possible.\n\n---\nUMKM MANAGEMENT Inventory System`,\n  productName: productName,\n  currentStock: currentStock,\n  minimumStock: minimumStock,\n  severity: severity,\n  productId: data.productId\n};\n\nreturn [{ json: notification }];"
      },
      "id": "0bee7f20-51f7-4fba-be9b-d047aaa43975",
      "name": "Format Notification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "functionCode": "const data = $input.first().json;\nconsole.log('=== LOW STOCK ALERT ===');\nconsole.log('Product:', data.productName);\nconsole.log('Current Stock:', data.currentStock);\nconsole.log('Minimum Stock:', data.minimumStock);\nconsole.log('Severity:', data.severity);\nconsole.log('=======================');\n\nreturn [{ json: { ...data, sentAt: new Date().toISOString(), status: 'logged' } }];"
      },
      "id": "fe9917f3-6388-4442-8e4f-fd7810db05c7",
      "name": "Log Notification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        208,
        0
      ]
    },
    {
